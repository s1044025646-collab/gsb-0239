{
  "name": "uni-table-layout",
  "version": "1.0.0",
  "description": "Unicode display-width plain-text table layout backend (API + CLI), TypeScript + Node.js + SQLite",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-sqlite --import ./scripts/ts-loader.mjs --test tests/*.test.ts",
    "start": "node --experimental-sqlite dist/cli.js serve",
    "dev": "node --experimental-sqlite --import ./scripts/ts-loader.mjs src/cli.ts serve",
    "cli": "node --experimental-sqlite --import ./scripts/ts-loader.mjs src/cli.ts",
    "demo": "node --experimental-sqlite --import ./scripts/ts-loader.mjs scripts/demo.mjs"
  },
  "bin": {
    "uni-table": "dist/cli.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "string-width": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
